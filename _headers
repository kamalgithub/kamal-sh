# Cloudflare-native header injection for every prerendered/static asset response —
# required because adapter-cloudflare's generated worker serves prerendered pages
# straight from env.ASSETS.fetch(), bypassing SvelteKit's handle() hook entirely
# (see src/hooks.server.ts, which covers only the genuinely SSR'd routes: /about, /contact).
# Keep these two files' header values in sync by hand — see also src/hooks.server.ts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.ytimg.com https://blog.aicademy.ac data:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
